# ==============================================================================
# DervGen Workspace Configuration & Credentials Example
# Copy this file to .env and fill in the values, or store them in Google Colab Secrets
# ==============================================================================

# Git / GitHub Configuration
GITHUB_USERNAME=yanglei
GITHUB_EMAIL=yanglei@dervgen.com
GITHUB_TOKEN=ghp_your_github_personal_access_token_here

# Hugging Face / Weights & Biases (Optional for ML workflows)
HF_TOKEN=hf_your_huggingface_token
WANDB_API_KEY=your_wandb_api_key

# Google Drive Sync Configuration
ENABLE_DRIVE_BACKUP=true
DRIVE_BACKUP_DIR=/content/drive/MyDrive/DervGen_Workspace_Backup

# Remote Tunnel Configuration
# Optional: VS Code Tunnel Token / Cloudflare Tunnel
VSCODE_TUNNEL_NAME=dervgen-colab-gpu
